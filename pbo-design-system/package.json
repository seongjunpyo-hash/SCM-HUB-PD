{
  "name": "musinsa-pbo-design-system",
  "version": "1.0.0",
  "description": "MUSINSA PBO design system",
  "main": "index.js",
  "private": true,
  "author": "MUSINSA-PBO-FE",
  "license": "ISC",
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "pbo-assets": "pnpm -F @musinsa/pbo-assets",
    "pbo-tokens": "pnpm -F @musinsa/pbo-tokens",
    "layer-components-desktop": "pnpm -F @musinsa/layer-components-desktop",
    "layer-components-pda": "pnpm -F @musinsa/layer-components-pda",
    "layer-tokens": "pnpm -F @musinsa/layer-tokens",
    "phase-tokens": "pnpm -F @musinsa/phase-tokens",
    "storybook": "pnpm -F @musinsa/layer-storybook",
    "lint:fix": "eslint --fix . --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write .",
    "prepare": "husky install",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:release": "changeset publish"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "**/*.{json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/node": "^24.0.10",
    "eslint": "^9.30.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "husky": "^8.0.0",
    "lint-staged": "^16.1.2",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.1"
  },
  "dependencies": {
    "@changesets/cli": "^2.29.5"
  }
}
