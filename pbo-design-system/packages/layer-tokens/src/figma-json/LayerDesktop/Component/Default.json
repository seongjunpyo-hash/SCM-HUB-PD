        "value": "{primitive.dimension}*50",
        "type": "dimension"
      },
      "bg": {
        "value": "{bg-low}",
        "description": "탭 바 기본 배경 색상",
        "type": "color"
      },
      "fg": {
        "value": "{fg}",
        "type": "color",
        "description": "탭 아이템 기본 전경 색상"
      },
      "fg-lower": {
        "value": "{fg-lower}",
        "type": "color",
        "description": "close 버튼 아이콘 색상"
      },
      "fg-disabled": {
        "value": "{fg-disabled}",
        "type": "color",
        "description": "탭 아이템 disabled 상태 전경 색상"
      },
      "border": {
        "value": "{stroke.border}",
        "description": "탭 아이템/트랙 구조 구분선",
        "type": "color"
      },
      "tab": {
        "bg": {
          "value": "{bg-low}",
          "description": "탭 아이템 기본 배경 색상",
          "type": "color"
        },
        "bg-hover": {
          "value": "{primitive.color.gray.200}",
          "description": "탭 아이템 hover 상태 배경 색상",
          "type": "color"
        },
        "bg-active": {
          "value": "{bg}",
          "description": "탭 아이템 active 상태 배경 색상",
          "type": "color"
        },
        "bg-closeButtonHover": {
          "value": "{primitive.color.gray.alpha500.20}",
          "type": "color"
        },
        "fg-active": {
          "value": "{fg}",
          "description": "탭 아이템 active 상태 전경 색상",
          "type": "color"
        }
      },
      "overflow": {
        "edgeFade": {
          "width": {
            "value": "{primitive.dimension}*3",
            "type": "sizing"
          },
          "gradient-left": {
            "$extensions": {
              "studio.tokens": {
                "modify": {
                  "type": "alpha",
                  "value": "0",
                  "space": "lch"
                }
              }
            },
            "value": "{primitive.color.gray.300}",
            "type": "color"
          },
          "gradient-right": {
            "$extensions": {
              "studio.tokens": {
                "modify": {
                  "type": "alpha",
                  "value": "1",
                  "space": "lch"
                }
              }
            },
            "value": "{primitive.color.gray.300}",
            "type": "color"
          }
        },
        "bg": {
          "value": "{bg}",
          "type": "color"
        }
      }
    },
    "pageHeader": {
      "overflow": {
        "edgeFade": {
          "width": {
            "value": "{primitive.dimension}*3",
