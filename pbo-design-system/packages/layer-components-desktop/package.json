{
  "name": "@musinsa/layer-components-desktop",
  "description": "MUSINSA PBO design system layer components for Desktop",
  "version": "0.4.1",
  "type": "module",
  "license": "MIT",
  "author": "MUSINSA-PBO-FE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/musinsa/pbo-design-system.git"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./style.css": "./dist/layer-components-desktop.css"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "require": "./dist/index.cjs",
        "import": "./dist/index.mjs"
      },
      "./package.json": "./package.json",
      "./style.css": "./dist/layer-components-desktop.css"
    },
    "types": "./dist/index.d.ts",
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "code-connect": "figma connect",
    "code-connect:publish": "figma connect publish",
    "layer:up": "pnpm update @musinsa/*"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "dependencies": {
    "@musinsa/layer-tokens": "^1.2.2",
    "@musinsa/pbo-assets": "^1.1.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collection": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@vanilla-extract/css": "^1.17.4",
    "@vanilla-extract/dynamic": "^2.1.5",
    "@vanilla-extract/recipes": "^0.5.7",
    "react-hook-form": "^7.65.0"
  },
  "devDependencies": {
    "@figma/code-connect": "^1.3.11",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest-axe": "^3.5.9",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.1",
    "@vanilla-extract/vite-plugin": "^5.1.0",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/ui": "^2.1.8",
    "jest-axe": "^9.0.0",
    "jsdom": "^25.0.1",
    "vite": "^7.0.3",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^2.1.8"
  }
