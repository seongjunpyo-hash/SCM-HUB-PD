{
  "$schema": "../schema/schema.json",
  "id": "filter-field",
  "version": "2.26.0",
  "displayName": "FilterField",
  "description": "통합 필터 칩. 단일/다중 선택 popover, 코드 입력 popover 를 동일한 trigger 외형으로 wiring. 필터 바·전체 필터 drawer 양쪽에서 동일한 컨트랙트로 사용.",
  "status": "stable",
  "platforms": ["web"],
  "tokens": {
    "color": {
      "background.default":      "bg.default",
      "background.hover":        "bg.low",
      "background.open":         "bg.default",
      "border.default":          "border.default",
      "border.hover":            "border.strong",
      "border.open":             "fg.default",
      "border.filled":           "fg.default",
      "label.placeholder":       "fg.lowest",
      "label.filled":            "fg.lower",
      "label.floating":          "fg.lower",
      "value.text":              "fg.default",
      "value.placeholder":       "fg.lowest",
      "chevron.default":         "fg.lower",
      "chevron.hover":           "fg.default",
      "popover.background":      "bg.default",
      "popover.shadow":          "border.low",
      "popover.divider":         "divider.low",
      "option.hover":            "bg.low",
      "option.selected":         "bg.accent-low"
    },
    "typography": {
      "label.size":     "fontSize.75",
      "label.weight":   "fontWeight.regular",
      "value.size":     "fontSize.150",
      "value.weight":   "fontWeight.regular",
      "value.lineHeight": "lineHeight.136"
    },
    "spacing": {
      "trigger.padding.x":  "space.200",
      "trigger.padding.y":  "space.150",
      "trigger.gap":        "space.100",
      "popover.padding":    "space.100",
      "option.padding.x":   "space.150",
      "option.padding.y":   "space.150"
    },
    "border": {
      "radius": "radius.sm",
      "width":  "border.width"
    },
    "motion": {
      "label.float":        "duration.fast",
      "popover.appear":     "duration.fast"
    }
  },
  "props": {
    "mode": {
      "type": "enum",
      "description": "Popover variant: single = 단일 라디오, multi = 다중 체크박스 + 검색, codeinput = 코드 멀티-라인 입력 + 적용.",
      "values": ["single", "multi", "codeinput"],
      "default": "single",
      "tokenMapped": true
    },
    "label":         { "type": "string", "description": "Floating label (필터 이름 — 시즌/컬러/카테고리 등).", "required": true },
    "value":         { "type": "ref", "ref": "filter-value", "description": "Mode 별 polymorphic — single=string, multi=string[], codeinput=string(개행 분리)." },
    "placeholder":   { "type": "string", "description": "값 미선택 시 표시 텍스트 (예: '전체')", "default": "전체" },
    "options":       { "type": "ref",    "ref": "filter-option[]", "description": "single/multi 모드에서 사용. id+label 페어." },
    "searchable":    { "type": "boolean", "description": "multi 모드 검색바 표시 여부", "default": true },
    "applyOnSelect": { "type": "boolean", "description": "single 모드: 선택 즉시 적용. multi/codeinput: false (적용 버튼)", "default": false },
    "open":          { "type": "boolean", "description": "popover open 상태 (controlled).", "default": false },
    "onChange":      { "type": "function", "required": true },
    "onApply":       { "type": "function" },
    "onReset":       { "type": "function" }
  },
  "states": ["default", "hover", "open", "filled", "filled-hover", "disabled"],
  "variants": [
    { "id": "single-empty",      "props": { "mode": "single",    "label": "시즌",       "value": null      } },
    { "id": "single-filled",     "props": { "mode": "single",    "label": "시즌",       "value": "26-SS"   } },
    { "id": "multi-empty",       "props": { "mode": "multi",     "label": "컬러",       "value": []        } },
    { "id": "multi-filled",      "props": { "mode": "multi",     "label": "컬러",       "value": ["미디엄 인디고", "워시드 블랙"] } },
    { "id": "codeinput-empty",   "props": { "mode": "codeinput", "label": "SKU번호",    "value": ""        } },
    { "id": "codeinput-filled",  "props": { "mode": "codeinput", "label": "SKU번호",    "value": "10669591\n10669592" } },
    { "id": "open",              "props": { "mode": "multi",     "label": "컬러",       "open": true       } },
    { "id": "disabled",          "props": { "mode": "single",    "label": "시즌",       "disabled": true   } }
  ],
  "composition": {
    "slots": {
      "trigger": {
        "description": "Floating-label 칩 (label, value, chevron).",
        "required": true,
        "childOrder": ["label", "value", "chevron"],
        "children": {
          "label":    { "type": "text", "figma": { "textProp": "label" } },
          "value":    { "type": "text", "figma": { "textProp": "value" } },
          "chevron":  { "type": "icon", "figma": { "name": "ic-chevronDown" } }
        }
      },
      "popover": {
        "description": "Trigger 아래 anchored. mode 별 다른 콘텐츠.",
        "children": {
          "search":      { "type": "ref", "ref": "search-input", "figma": { "visible": false, "booleanProp": "searchable" } },
          "options":     { "type": "ref", "ref": "filter-option-list", "showWhen": "mode != 'codeinput'" },
          "codeTextarea":{ "type": "ref", "ref": "textarea",       "showWhen": "mode == 'codeinput'" },
          "actions":     {
            "type": "group",
            "children": {
              "reset":   { "type": "ref", "ref": "button", "figma": { "instanceVariant": "ghost-md" } },
              "apply":   { "type": "ref", "ref": "button", "figma": { "instanceVariant": "primary-md" } }
            },
            "showWhen": "applyOnSelect == false"
          }
        }
      }
    }
  },
  "behavior": {
    "focusable": true,
    "pressable": true,
    "keyboardShortcuts": [
      { "key": "Enter",   "action": "Toggle popover (trigger focused) / Apply (popover focused)" },
      { "key": "Escape",  "action": "Close popover" },
      { "key": "ArrowDown","action": "Move focus to next option (open popover)" }
    ]
  },
  "accessibility": {
    "role": "combobox",
    "labelSource": "prop",
    "wcagLevel": "AA",
    "ariaExpanded": "open",
    "ariaHaspopup": "listbox"
  },
  "usage": {
    "do": [
      "필터 바와 전체 필터 drawer 양쪽에서 동일 contract 인스턴스로 재사용.",
      "single 모드는 applyOnSelect=true (선택 즉시 적용) 으로 popover 자동 닫힘.",
      "multi/codeinput 은 applyOnSelect=false (확정 버튼) 로 의도된 검색만 트리거."
    ],
    "dont": [
      "filter-field 안에 또 다른 filter-field 를 중첩하지 말 것.",
      "value 가 null 일 때 'placeholder' 자체를 검색 필터로 통과시키지 말 것 (전체 의미)."
    ]
  },
  "changelog": [
    { "version": "2.26.0", "date": "2026-04-29", "summary": "all-filter drawer 통합 — single/multi/codeinput 동일 contract 으로 wiring." },
    { "version": "2.25.0", "date": "2026-04-22", "summary": "FilterPopoverMulti 와 통합 (이전엔 별도 컴포넌트)." }
  ]
}
